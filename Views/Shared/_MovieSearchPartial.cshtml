        <h1><a asp-controller="Home" asp-action="Index">小狸影视</a></h1>
    </div>
    <div class="layui-form layui-col-md10">
        <div class="layui-input-wrap">
            <input type="text" list="ID-search-list" lay-affix="search" lay-filter="search" lay-options="{split: true}" value="@Model" placeholder="请输入影视名称" id="ID-search" class="layui-input">
            <datalist id="ID-search-list">

            </datalist>
        </div>
    </div>
</div>
