<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <title>@ViewData["title"]</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <link rel="stylesheet" href="/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="/sitecss/wtm.css">
    <link rel="stylesheet" href="/font/iconfont.css">
    <link rel="shortcut icon" href="/favicon.ico" />
</head>

<body>
    <div id="LAY_app"></div>
    <script src="/jquery.min.js" asp-append-version="true"></script>
    <script src="/jquery.cookie.js" asp-append-version="true"></script>
    <script src="/echarts/json-fns.js" asp-append-version="true"></script>
    <script src="/layui/layui.js" asp-append-version="true"></script>
    <script src="/layui/xm-select.js" asp-append-version="true"></script>
    <script src="/echarts/echarts.min.js" asp-append-version="true"></script>
    <script src="/echarts/chalk.js" asp-append-version="true"></script>
    <script src="/echarts/essos.js" asp-append-version="true"></script>
    <script src="/echarts/theme/macarons.js" asp-append-version="true"></script>
    <script src="/echarts/theme/roma.js" asp-append-version="true"></script>
    <script src="/echarts/theme/vintage.js" asp-append-version="true"></script>
    <script src="/echarts/walden.js" asp-append-version="true"></script>
    <script src="/echarts/westeros.js" asp-append-version="true"></script>
    <script src="/echarts/wonderland.js" asp-append-version="true"></script>
    <script src="/_js/framework_layui.js?time=@DateTime.Now.Ticks" asp-append-version="true"></script>
    <script>
        var DONOTUSE_IGNOREHASH = false;
        var DONOTUSE_COOKIEPRE = '@ViewData["DONOTUSE_COOKIEPRE"]';
        var DONOTUSE_WINDOWGUID = '@Guid.NewGuid().ToString().Replace("-", "")';
        layui.config({
            base: '/layuiadmin/'
            , version: '@DateTime.Now.Ticks'
        });
    </script>
    @RenderBody()
</body>
</html>
