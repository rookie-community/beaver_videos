@using MoviesLibrary.Enums
@using MoviesLibrary.Model
@using System.Text.Json
@model IEnumerable<IGrouping<CatType, TopInfoModel>>
@{
    ViewData["title"] = "首页 - 小狸影视";
    var routeData = new Dictionary<string, string>();
}
<div class="layui-container">
    <vc:navigation name=""></vc:navigation>
    <blockquote class="layui-elem-quote" style="margin-top:20px;">排行榜</blockquote>
    <div class="layui-row">
        <div class="layui-tab layui-tab-brief" lay-filter="docDemoTabBrief">
            <ul class="layui-tab-title">
                <li class="layui-this">电影</li>
                <li>电视剧</li>
                <li>综艺</li>
                <li>动漫</li>
            </ul>
            <div class="layui-tab-content" style="height: 100px;">
                @foreach (var tops in Model)
                {
                    <div class="layui-tab-item @(tops.Key==CatType.Film?"layui-show":null)">
                        <div class="layui-row">
                            @foreach (var item in tops)
                            {
                                routeData = new Dictionary<string, string>()
                        {
                        { "entId",item.EntId},
                        { "catType",((int)item.Cat).ToString()}
                        };
                                <div class="layui-col-md2 layui-col-sm4">
                                    <div class="layui-panel" style="width:180px;height:275px;margin:5px;">
                                        <a asp-controller="Movie" asp-action="Detail" asp-all-route-data="routeData" target="_blank">
                                            <img src="@item.Cover" style="width:180px;height:235px;"/>
                                            <label class="layui-form-label" style="width:150px;text-align:center">@item.Title</label>
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>