@using MoviesLibrary.Model
@model IEnumerable<Movie>
@{
    ViewData["title"] = $"小狸影视 - “{ViewBag.Name}”的搜索结果";
    var routeData = new Dictionary<string, string>();
}
<div class="layui-container">
    <vc:navigation name="@ViewBag.Name"></vc:navigation>
    @if (Model.Any())
    {
        foreach (var item in Model)
        {
            routeData = new Dictionary<string, string>()
    {
    { "entId",item.EntId},
    { "catType",((int)item.Cat).ToString()}
    };
            <a asp-controller="Movie" asp-action="Detail" asp-all-route-data="routeData">
                <div class="layui-row layui-panel" style="margin:10px 0px;">
                    <div class="layui-col-md2">
                        <img src="@item.Cover" style="width:180px;height:240px;">
                    </div>

                    <div class="layui-col-md10">
                        <h2 style="margin:15px 0px">@item.Title</h2>
                        <h3 style="margin:10px 0px;">@item.CatName / @item.Year</h3>
                        <div class="layui-row">
                            <p>@item.Description</p>
                        </div>
                    </div>
                </div>
            </a>
        }
    }
    else
    {
        <div class="layui-panel">
            <h3>查无数据</h3>
        </div>
    }
</div>
