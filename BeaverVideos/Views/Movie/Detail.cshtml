@using MoviesLibrary.Model
@model MovieDetail
@{
    ViewData["title"] = "小狸影视 - 详情";
    int VideoIndex = 0;
    var url = $"https://jx.parwix.com:4433/player/analysis.php?v=https://v.qq.com/x/cover/mzc002004po9jj4/m0041wdhlex.html";
    int total = Model.UpInfo == 0 ? 1 : Model.UpInfo;
    var tabs = total / 50 == 0 ? total : total / 50 + 1;
}
<div class="layui-container">
    @await Component.InvokeAsync("Navigation",new {name=ViewBag.Name})
    <div class="layui-row">
        <div class="layui-col-md8">
            <div class="layui-panel">
                <iframe width="100%" height="300" allowtransparency="true" frameborder="0" scrolling="no" allowfullscreen="true" src="@url" autoplay="true"></iframe>
            </div>
            <div>
                <div class="layui-collapse" lay-filter="test">
                    <div class="layui-colla-item">
                        <h2 class="layui-colla-title">《@Model.Title》简介</h2>
                        <div class="layui-colla-content">
                            <p>@Model.Description</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="layui-col-md4" style="margin-left:10px;">
            <h1>@Model.Title</h1>
            <div class="layui-tab layui-tab-brief" lay-filter="docDemoTabBrief" style="height:350px;overflow-y:auto;">
                <ul class="layui-tab-title">
                    @for (var i = 0; i < tabs; i++)
                    {
                        <li class="@(i==0?"layui-this":null)">@($"{i*50+1} - {(i+1)*50}")</li>
                    }
                </ul>
                <div class="layui-tab-content" style="height: 100px;">
                    @foreach (var item in Model.PlayLinksDetail)
                    {
                        VideoIndex++;
                        var routeData = new Dictionary<string, string>()
                    {
                    { "entId",ViewBag.EntId},
                    { "catType",ViewBag.Cat},
                    { "index",VideoIndex.ToString()}
                    };
                        if (VideoIndex % 50 == 1)
                        {
                            if (VideoIndex <= ViewBag.ThisIndex && ViewBag.ThisIndex <= (VideoIndex + 49))
                            {
                                @Html.Raw($"<div class=layui-tab-item layui-show>")
                            }
                            else
                            {
                                @Html.Raw($"<div class=layui-tab-item>")
                            }
                        }
                        <a asp-controller="Movie" asp-action="Detail" asp-all-route-data="routeData" class="layui-btn @(ViewBag.ThisIndex==VideoIndex?"layui-btn-normal":"layui-btn-primary")" style="width:60px;margin:5px;">@VideoIndex</a>
                        if (VideoIndex % 50 == 0 || VideoIndex == Model.PlayLinksDetail.Count)
                        {
                            @Html.Raw("</div>")
                        }
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="layui-row">
        <blockquote class="layui-elem-quote" style="margin-top:20px;">精彩推荐</blockquote>
        <div class="layui-row">
            @foreach (var item in Model.MovieRecommends)
            {
                var otherRouteData = new Dictionary<string, string>()
            {
            { "entId",item.EntId},
            { "catType",((int)item.Cat).ToString()}
            };
                <div class="layui-col-md2 layui-col-sm4">
                    <div class="layui-panel" style="width:180px;height:275px;margin:5px;">
                        <a asp-controller="Movie" asp-action="Detail" asp-all-route-data="otherRouteData" target="_blank">
                            <img src="@item.Cover" style="width:180px;height:235px;" />
                            <label class="layui-form-label" style="width:150px;text-align:center">@item.Title</label>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
