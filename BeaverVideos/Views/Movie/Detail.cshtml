@using MoviesLibrary.Enums
@using MoviesLibrary.Model
@model MovieDetail
@{
    ViewData["title"] = $"{Model.Title} - 小狸影视";
    int VideoIndex = 0;//用于循环时输出剧集的索引
    int upInfo = Model.UpInfo == 0 ? 1 : Model.UpInfo;
    var tabs = upInfo / 50 == 0 && upInfo > 50 ? upInfo : upInfo / 50 + 1;
    Dictionary<string, string> valuePairs = ViewBag.PlayTypeList;//所有线路
}
<div class="layui-container">
    <vc:navigation name="@Model.Title"></vc:navigation>
    <div class="layui-row">
        <div class="layui-col-md8">
            <div class="layui-panel" style="height:420px;">
                <iframe style="width:100%;height:inherit;" allowtransparency="true" frameborder="0" scrolling="no" allowfullscreen="true" src="@ViewBag.PlayUrl" autoplay="true"></iframe>
            </div>
            <div>
                <div class="layui-collapse" lay-filter="test">
                    <div class="layui-colla-item">
                        <h2 class="layui-colla-title">
                            《@Model.Title》简介
                            @Html.Raw("&nbsp;&nbsp;&nbsp;&nbsp;")
                            @Html.Raw((Model.Vip?"<span class='layui-badge'>VIP</span>":"<span class='layui-badge layui-bg-blue'>免费</span>"))
                            <span class="layui-badge layui-bg-black">
                                导演：
                                @foreach (var item in Model.Director)
                                {
                                    @Html.Raw($"{item}&nbsp;&nbsp;&nbsp;&nbsp;")
                                }
                            </span>
                            @foreach (var item in Model.Moviecategory)
                            {
                                <span class="layui-badge-rim">@item</span>
                            }
                        </h2>
                        <div class="layui-colla-content">
                            <p>@Model.Description</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="layui-col-md4" style="padding-left:5px;">
            <h2 style="margin:0px 0px 10px 15px;">@Model.Title</h2>
            <div class="layui-form">
                <form asp-controller="Movie" asp-action="Detail" method="get">
                    <div class="layui-row">
                        <label class="layui-form-label layui-col-md4" style="width:120px;">当前线路:</label>
                        <input style="display:none;" name="entId" value="@Model.EntId" />
                        <input style="display:none;" name="catType" value="@Model.Cat">
                        <input style="display:none;" name="index" value="@ViewBag.ThisIndex">
                        <div class="layui-input-inline layui-col-md6">
                            <select name="linkType">
                                @foreach (var item in Model.PlayLinkSites)
                                {
                                    <option value="@item" selected="@(item==Model.ThisPlayLink.ToString()?"selected":null)">@(Enum.TryParse(item, out PlayLinkType type)?valuePairs[$"{(int)type}"]:item)</option>
                                }
                            </select>
                        </div>
                        <button class="layui-btn layui-btn-primary layui-border-blue layui-col-md2" type="submit">切换</button>
                    </div>
                </form>
            </div>
            <div class="layui-tab layui-tab-brief" lay-filter="docDemoTabBrief">
                <ul class="layui-tab-title">
                    @for (var i = 0; i < tabs; i++)
                    {
                        if (Model.Cat == MoviesLibrary.Enums.CatType.Film)
                        {
                            <li class="layui-this">播放列表</li>
                        }
                        else
                        {
                            <li @(i==0?"class=layui-this":null)>@($"{i*50+1} - {((i+1)*50>upInfo?upInfo:(i+1)*50)}")</li>
                        }
                    }
                </ul>
                <div class="layui-tab-content" style="overflow-y:auto;">
                    @foreach (var item in Model.PlayLinksDetail)
                    {
                        VideoIndex++;
                        var routeData = new Dictionary<string, string>()
                    {
                    { "entId",Model.EntId},
                    { "catType",((int)Model.Cat).ToString()},
                    { "linkType",Model.ThisPlayLink.ToString()},
                    { "index",VideoIndex.ToString()}
                    };
                        if (VideoIndex % 50 == 1)
                        {
                            if (VideoIndex <= ViewBag.ThisIndex && ViewBag.ThisIndex <= (VideoIndex + 49))
                            {
                                @Html.Raw($"<div class='layui-tab-item layui-show' style='max-height:420px;min-height:100px;'>")
                            }
                            else
                            {
                                @Html.Raw($"<div class='layui-tab-item' style='max-height:420px;min-height:100px;'>")
                            }
                        }
                        <a asp-controller="Movie" asp-action="Detail" asp-all-route-data="routeData" class="layui-btn layui-btn-sm @(ViewBag.ThisIndex==VideoIndex?"layui-btn-normal":"layui-btn-primary")" style="width:55px;margin:3px;">@VideoIndex
                        @Html.Raw(item.Value.EndsWith(".pay")?$"<span class='layui-badge' style='padding:1px;'>vip</span>":null)</a>
                        if (VideoIndex % 50 == 0 || VideoIndex == Model.PlayLinksDetail.Count)
                        {
                            @Html.Raw("</div>")
                        }
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="layui-row">
        <blockquote class="layui-elem-quote" style="margin-top:20px;">精彩推荐</blockquote>
        <div class="layui-row">
            @foreach (var item in Model.MovieRecommends)
            {
                var otherRouteData = new Dictionary<string, string>()
            {
            { "entId",item.EntId},
            { "catType",((int)item.Cat).ToString()}
            };
                <div class="layui-col-md2 layui-col-sm3">
                    <div class="layui-panel" style="width:170px;height:275px;margin:5px;">
                        <a asp-controller="Movie" asp-action="Detail" asp-all-route-data="otherRouteData" target="_blank">
                            <img src="@item.Cover" style="width:170px;height:235px;" />
                            <label class="layui-form-label" style="width:150px;text-align:center;padding:2px 15px;">@item.Title</label>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>