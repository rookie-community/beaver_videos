<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 小狸影视</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="~/lib/layui/css/layui.min.css" rel="stylesheet" asp-append-version="true" />
    <style>
        .ws-footer {
            padding: 10px 0;
            line-height: 30px;
            text-align: center;
            color: #777;
        }
    </style>
</head>
<body>
    @RenderBody()
    <div class="layui-footer ws-footer">
        <p>
            Copyright &copy; 2025 <a asp-area="" asp-controller="Home" asp-action="Index">小狸影视</a> MIT Licensed
        </p>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/layui/layui.min.js" asp-append-version="true"></script>
    <script src="~/lib/xm-select/dist/xm-select.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <partial name="_BaiduStatisticsScriptsPartial"/>
</body>
</html>
